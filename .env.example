APP_NAME=DevKnow - Multi-Language Developer Knowledge Assistant
APP_ENV=development

# Server Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173

# Database Connection String (Single-line URI)
# MySQL format:  mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>?charset=utf8mb4
# SQLite format: sqlite:///data/devknow.db
DATABASE_URL=mysql+pymysql://root:@localhost:3306/devknow_db?charset=utf8mb4

# ── LLM Behavior Modes ───────────────────────────────────────────────────────
# Options: "STRICT" (Deterministic, temperature 0.1, zero hallucination)
#          "CREATIVE" (Exploratory refactoring, temperature 0.7)
LLM_MODE=STRICT
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.95
LLM_MAX_TOKENS=8192

# ── LLM Provider Configuration ───────────────────────────────────────────────
# Active Provider Options: "gemini" | "openai" | "claude" | "azure_openai" | "custom"
LLM_PROVIDER=gemini

# ── 1. Google Gemini Settings ───────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ── 2. OpenAI (ChatGPT / GPT-4o) ────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ── 3. Anthropic Claude ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── 4. Azure OpenAI / Copilot ───────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ── 5. Local / Custom LLM (Ollama, vLLM, Mistral) ───────────────────────────
LLM_API_URL=
LLM_MODEL=mistral-small:24b
LLM_TIMEOUT=300

# ── Embedding Provider & Dimensionality Modes ────────────────────────────────
# EMBEDDING_PROVIDER options:
#   "LOCAL"  -> sentence-transformers/all-MiniLM-L6-v2 (384-dim, 100% free, runs on CPU locally)
#   "GEMINI" -> models/text-embedding-004 (768-dim, Google GenAI cloud API)
EMBEDDING_PROVIDER=LOCAL
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Storage Paths
CHROMA_PATH=data/chroma_db
UPLOAD_PATH=data/uploads
MAX_UPLOAD_SIZE_MB=50

# RAG & Retrieval Settings
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.50
CONVERSATION_MEMORY_TURNS=10

# Self-Growing Knowledge Base
AUTO_SAVE_LLM_ANSWERS=false

# Excel Column Mapping Configuration
COL_RULE_NAME=RuleVersionName
COL_RULE_DESC=RuleVersionDescription
COL_SCRIPT_HEADER=Rule Version Script Header/Name
COL_SCRIPT_BODY=Rule Version Script Body
COL_LANGUAGE=Programming Language
COL_FRAMEWORK=Framework
COL_VERSION=Version
COL_CLASS=Class Name
COL_NAMESPACE=Namespace
COL_DESCRIPTION=Description
COL_METADATA=Additional Metadata
