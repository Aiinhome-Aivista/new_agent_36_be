APP_NAME=DevKnow - Multi-Language Developer Knowledge Assistant
APP_ENV=development

# Server Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173

# Database Connection String (Single-line URI)
# MySQL format:  mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>?charset=utf8mb4
# SQLite format: sqlite:///data/devknow.db
DATABASE_URL=mysql+pymysql://root:@localhost:3306/devknow_db?charset=utf8mb4

# ── LLM Behavior Modes ───────────────────────────────────────────────────────
# Options: "STRICT" (Deterministic, temperature 0.1, zero hallucination)
#          "CREATIVE" (Exploratory refactoring, temperature 0.7)
LLM_MODE=STRICT
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.95
LLM_MAX_TOKENS=8192

# ── LLM Provider Configuration ───────────────────────────────────────────────
# Active Provider Options: "gemini" | "openai" | "claude" | "azure_openai" | "custom"
LLM_PROVIDER=gemini

# ── 1. Google Gemini Settings ───────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ── 2. OpenAI (ChatGPT / GPT-4o) ────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ── 3. Anthropic Claude ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── 4. Azure OpenAI / Copilot ───────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ── 5. Local / Custom LLM (Ollama, vLLM, Mistral) ───────────────────────────
LLM_API_URL=
LLM_MODEL=mistral-small:24b
LLM_TIMEOUT=300

# ── Embedding Provider & Dimensionality Modes ────────────────────────────────
# EMBEDDING_PROVIDER options:
#   "LOCAL"  -> sentence-transformers/all-MiniLM-L6-v2 (384-dim, 100% free, runs on CPU locally)
#   "GEMINI" -> models/text-embedding-004 (768-dim, Google GenAI cloud API)
EMBEDDING_PROVIDER=LOCAL
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Storage Paths
CHROMA_PATH=data/chroma_db
UPLOAD_PATH=data/uploads
MAX_UPLOAD_SIZE_MB=50

# RAG & Retrieval Settings
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.50
CONVERSATION_MEMORY_TURNS=10
# Call-Graph Dependency Expansion: Automatically resolve child functions called by parent functions
ENABLE_CALL_GRAPH_EXPANSION=true
CALL_GRAPH_MAX_DEPTH=2
CALL_GRAPH_TOKEN_BUDGET=1200
CALL_GRAPH_STUB_THRESHOLD_LINES=50
CALL_GRAPH_PROXIMITY_BOOST=true
CALL_GRAPH_MAX_CHILDREN=5
# Conversational Query Reformulation: Contextualize short follow-ups using recent chat turns
ENABLE_QUERY_REFORMULATION=true

# ── Hybrid Retrieval & Reciprocal Rank Fusion (RRF) ─────────────────────────
# Cormack rank smoothing constant (standard default: 60)
RRF_K=60
# Channel weights: 1.0 for dense semantic vectors, 1.25 for exact code identifiers
RRF_VECTOR_WEIGHT=1.0
RRF_KEYWORD_WEIGHT=1.25
# Candidate pool limits
RRF_CANDIDATE_LIMIT=15
RRF_CANDIDATE_MULTIPLIER=3

# Keyword Channel Scoring Weights (Tuning for exact function, class & signature matches)
RRF_KEYWORD_EXACT_FN_SCORE=10.0
RRF_KEYWORD_PARTIAL_FN_SCORE=5.0
RRF_KEYWORD_CLASS_SCORE=8.0
RRF_KEYWORD_HEADER_SCORE=3.0

# Grounding Attribution Bounds (% minimum & maximum attributed to verified knowledge base)
RAG_KB_RATIO_MIN=65
RAG_KB_RATIO_MAX=95

# ── Codebase Ingestion & Blueprint Settings ──────────────────────────────────
FILE_SUMMARY_PREFIX=FileSummary_
DEFAULT_INITIAL_VERSION=1.0.0
CODEBASE_MAX_FILE_SIZE_KB=500
# Number of functions to batch together in a single LLM semantic summarization call
SEMANTIC_BATCH_SIZE=8
# Immutable exclusion lists (comma-separated directory names and file patterns)
CODEBASE_SKIP_DIRS=__pycache__,node_modules,.git,.hg,.svn,bin,obj,dist,build,.venv,venv,env,.tox,.mypy_cache,.pytest_cache,coverage,.idea,.vscode,migrations,__MACOSX
CODEBASE_SKIP_FILENAME_PATTERNS=test_,_test,.test.,.spec.,.min.,.bundle.,setup.cfg,pyproject.toml,package-lock.json,yarn.lock,requirements.txt,Pipfile,Pipfile.lock,.env

# Self-Growing Knowledge Base
AUTO_SAVE_LLM_ANSWERS=false

# Excel Column Mapping Configuration
COL_RULE_NAME=RuleVersionName
COL_RULE_DESC=RuleVersionDescription
COL_SCRIPT_HEADER=Rule Version Script Header/Name
COL_SCRIPT_BODY=Rule Version Script Body
COL_LANGUAGE=Programming Language
COL_FRAMEWORK=Framework
COL_VERSION=Version
COL_CLASS=Class Name
COL_NAMESPACE=Namespace
COL_DESCRIPTION=Description
COL_METADATA=Additional Metadata
